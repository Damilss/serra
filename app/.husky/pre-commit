# Serra pre-commit: runs on every commit in the repo (husky sets core.hooksPath to app/.husky).
# Runs from the repository root. Skip once with `git commit --no-verify`.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found on PATH, so the checks can't run. Install Node.js or commit from a terminal that has it." >&2
  exit 1
fi

# 1. Secrets in what's staged, anywhere in the repo.
node app/scripts/gitleaks.mjs staged || exit 1

# 2. Repo-wide hygiene: no .env / key files, no files over 5 MB, no conflict markers.
node app/scripts/check-staged.mjs || exit 1

# 3. Lint and format staged files under app/ (fixes what it can and re-stages them).
cd app && npx --no-install lint-staged
